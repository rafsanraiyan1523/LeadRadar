# Copy to .env and adjust for your local setup.

NODE_ENV=development
API_PORT=4000

# Points at the Postgres container from docker/docker-compose.yml, or a local instance.
DATABASE_URL="postgresql://leadradar:leadradar_dev_password@localhost:5432/leadradar?schema=public"

REDIS_URL="redis://localhost:6379"

# Origin allowed to make credentialed requests (CORS).
WEB_ORIGIN="http://localhost:3000"

# Secret used to sign cookies. Generate a strong random value for production,
# e.g. `openssl rand -base64 32`.
JWT_SECRET="dev-insecure-jwt-secret"
COOKIE_SECRET="dev-insecure-cookie-secret"
# Reserved for future use — refresh tokens are opaque, high-entropy random
# values (not JWTs), so this isn't consumed by anything yet. Still required
# to differ from a placeholder in production (see main.ts's startup guard)
# so it's here for forward compatibility, not decoration.
JWT_REFRESH_SECRET="dev-insecure-jwt-refresh-secret"

# ---- Token lifetimes ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7

# ---- Zero-cost demo mode ----
# All three default to true — the whole product is demo-ready with zero
# external accounts. Flip individually to opt into a real provider once its
# credentials are configured below (each still falls back to mock/local
# automatically if the credentials are missing).
MOCK_GOOGLE=true
MOCK_AI=true
# Governs `pnpm db:seed` — set to false to skip populating the synthetic
# demo dataset (50+ businesses, 200 leads) in an environment with real data.
MOCK_DATA=true

# ---- Lead discovery (Google Maps / Places) ----
# Only takes effect once MOCK_GOOGLE=false, GOOGLE_MAPS_ENABLED=true, AND a
# key is set below — any one of those missing falls back to the mock
# provider automatically.
GOOGLE_MAPS_ENABLED=false
# GOOGLE_MAPS_API_KEY=

# Cost/abuse controls for the lead-discovery provider (Google mode).
MAX_RESULTS_PER_SEARCH=20
MAX_CONCURRENT_REQUESTS=3
GOOGLE_REQUEST_RATE_LIMIT=10

# ---- AI (business intelligence & outreach) ----
# MOCK (default, and forced whenever MOCK_AI=true) needs no external account
# and is fully functional — deterministic, template-based generation over
# the same verified lead data. LOCAL uses a locally-running Ollama instance
# (truly zero-cost, everything stays on this machine). EXTERNAL calls a real
# hosted AI API and needs AI_API_KEY — falls back to MOCK automatically if
# unset. Set MOCK_AI=false to let AI_MODE take effect.
AI_MODE=mock

# ---- LOCAL mode (Ollama) ----
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ---- EXTERNAL mode (hosted AI API — Anthropic-compatible) ----
# AI_API_KEY=
# Short/simple generations here (lead summaries, outreach messages) run
# cheaply on a smaller model too, e.g. claude-haiku-4-5.
AI_MODEL="claude-opus-5"
