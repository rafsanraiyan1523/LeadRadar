# Copy to .env and adjust for your local setup.

NODE_ENV=development
REDIS_URL="redis://localhost:6379"
WORKER_HEALTH_PORT=4100

# Same Postgres the api connects to — the worker writes Search/SearchResult
# rows directly (via @lead-radar/db, generated from apps/api/prisma/schema.prisma).
DATABASE_URL="postgresql://leadradar:leadradar_dev_password@localhost:5432/leadradar?schema=public"

# Cost/abuse controls when a job runs in GOOGLE provider mode.
MAX_CONCURRENT_REQUESTS=3
GOOGLE_REQUEST_RATE_LIMIT=10

# Website crawler bounds (lead enrichment) — a controlled, bounded crawl of
# a lead's own site, never a general-purpose scraper.
MAX_PAGES=5
MAX_RESPONSE_SIZE=2000000
REQUEST_TIMEOUT=8000
CRAWLER_REQUEST_DELAY_MS=300

# ---- Optional external providers (leave unset to use mock/local providers) ----
# Mirrors apps/api's MOCK_GOOGLE/GOOGLE_MAPS_API_KEY — the worker itself
# always executes whatever provider mode the API assigned to a job (see
# LeadDiscoveryJobData.providerMode), so this only supplies the credential
# once GOOGLE mode is actually requested; it doesn't independently decide
# mock vs. real.
# GOOGLE_MAPS_API_KEY=
