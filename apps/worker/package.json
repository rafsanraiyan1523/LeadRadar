  },
  "devDependencies": {
    "@lead-radar/eslint-config": "workspace:*",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
