# Root environment file — consumed by docker-compose for service credentials
# and passed through to the api/worker containers (see docker/docker-compose.yml).
# Individual apps (web/api/worker) each have their own .env.example for
# non-Docker local dev — this file is the reference for what the *whole
# stack* needs when run via `pnpm docker:up:full` / `docker compose --profile full up`.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=leadradar
POSTGRES_PASSWORD=leadradar_dev_password
POSTGRES_DB=leadradar
POSTGRES_PORT=5432

# ---- Redis (docker-compose) ----
REDIS_PORT=6379

# ---- App secrets — required in production, insecure defaults in dev ----
# Generate strong random values for a real deployment, e.g. `openssl rand -base64 32`.
# Must be distinct from each other. The api refuses to start in
# NODE_ENV=production with a missing/default/shared value here.
JWT_SECRET=dev-insecure-jwt-secret
JWT_REFRESH_SECRET=dev-insecure-jwt-refresh-secret
COOKIE_SECRET=dev-insecure-cookie-secret

# ---- Frontend -> API wiring ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Zero-cost demo mode (see docs/deployment.md#demo-mode) ----
MOCK_GOOGLE=true
MOCK_AI=true
MOCK_DATA=true

# ---- Optional paid providers — only take effect once their MOCK_* flag
# above is false AND (for Google) GOOGLE_MAPS_ENABLED=true ----
GOOGLE_MAPS_ENABLED=false
# GOOGLE_MAPS_API_KEY=
AI_MODE=mock
# AI_API_KEY=
AI_MODEL=claude-opus-5
